# Names only — set real values in Vercel → Settings → Environment Variables
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SECRET — Supabase → Project Settings → API Keys → service_role / secret key. Server only, never in the app.
ADMIN_PASSWORD=                     # password for /admin (min 8 chars)
SESSION_SECRET=                     # optional, any long random string (defaults to service key)
OWNER_EMAIL=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_ALLOW_SIMULATION=false   # true = allow fake "sandbox" payments on the live site (demo only)
SMS_DRIVER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
RESEND_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
SENTRY_DSN=
