{
  "meta": {
    "project": "PaatKotha (পাটকথা) — jute products e-commerce, Bangladesh",
    "version": "1.0",
    "date": "2026-09-27",
    "how_to_use": [
      "Open this repo folder as the Antigravity workspace; rules in .agents/rules load automatically.",
      "Run the phase skills in order: /pk-00-plan, /pk-01-foundation … /pk-14-ios-release (one new conversation per phase).",
      "Every value here is the source of truth; PLACEHOLDER values are replaced by the owner via admin/seed."
    ]
  },
  "agent_instructions": {
    "role": "Senior full-stack engineer + product designer building a production e-commerce site.",
    "goal": "Build and deploy a Bangla-first, bilingual jute-products store (B2C) with a B2B custom-order/quote flow, an admin panel and a versioned REST API that a Flutter app will use later.",
    "non_goals": [
      "No marketplace/multi-vendor",
      "No international shipping",
      "No payment methods other than COD, SSLCommerz, and bank transfer (B2B)",
      "Do not invent reviews, client logos or statistics"
    ],
    "workflow": [
      "plan → owner approval",
      "foundation (repo, Next.js, Tailwind tokens, Supabase schema)",
      "layout + components + /styleguide",
      "core pages (home, shop, product, cart, checkout, tracking)",
      "B2B pages + quote flow",
      "admin panel",
      "payments (SSLCommerz sandbox) + SMS/email",
      "i18n + SEO + analytics",
      "QA + handoff docs"
    ],
    "working_rules": [
      "Plan first (Planning mode), then small steps; after each step run locally and verify with the browser agent (screenshots).",
      "Keep ALL pricing logic in web/lib/pricing.ts and call it only from server code; write unit tests with pricing.test_examples.",
      "Never put secrets in code or chat; use environment variables and list required ones in .env.example.",
      "Update docs/CHANGELOG.md and docs/DECISIONS.md after every phase.",
      "Ask before changing prices, payment logic, database schema or anything already approved."
    ]
  },
  "tech_constraints": {
    "web": "Next.js (latest stable, App Router) + TypeScript strict + Tailwind CSS (tokens as CSS variables) + shadcn/ui components restyled to brand",
    "backend": "Supabase (Postgres, Auth, Storage, RLS). Server-side Route Handlers under /api/v1 for everything the app needs.",
    "hosting": "Vercel (preview per branch, production on main).",
    "images": "next/image, WebP/AVIF, width-based srcset; placeholder images = neutral cream boxes with product name, NOT stock photos of other brands.",
    "i18n": "next-intl (or equivalent) with bn default, en secondary; URL prefix /en for English.",
    "browser_support": "last 2 versions of Chrome/Android WebView, Safari iOS 15+, Firefox, Edge",
    "testing": "Vitest for pricing + API; Playwright smoke test for checkout."
  },
  "project_structure": {
    "tree": [
      "web/app/(shop)/…",
      "web/app/admin/…",
      "web/app/api/v1/…",
      "web/lib/pricing.ts",
      "web/lib/pricing.test.ts",
      "web/messages/bn.json",
      "web/messages/en.json",
      "supabase/migrations/*.sql",
      "supabase/seed.sql",
      "app/ (Flutter, phase 2)",
      "docs/"
    ],
    "routing_note": "Product detail = /p/[slug]; category = /shop/[category]; quote view = /quote/[token]; order = /order/[number]."
  },
