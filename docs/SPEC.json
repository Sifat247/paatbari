  "business_rules": {
    "currency": {
      "symbol": "৳",
      "format_bn": "৳১,৪৫০ (Bangla digits)",
      "format_en": "৳1,450",
      "decimals": 0,
      "grouping": "South-Asian (1,00,500)"
    },
    "pricing": {
      "storage": "products.variants.price, bundles.discount_pct, coupons, settings (delivery_zones, free_threshold, b2b_*) — nothing hard-coded",
      "b2c_formula": "line = price×qty; bundle = round(Σitems×(1−pct))×qty; discount = round(subtotal×coupon%); delivery = (subtotal−discount) ≥ free_threshold ? 0 : zone.fee; total = subtotal − discount + delivery",
      "b2b_formula": "qty<moq → BELOW_MOQ; unit = tier.unit + (logo ? logo_fee : 0); total = unit×qty + (logo ? setup_fee : 0); deposit = round(total×deposit_pct)",
      "server_authority": "Server recalculates on every quote/order; client prices are ignored; orders store snapshots.",
      "show_calculation": "Cart lines show e.g. '২ × ৳৪৫০ = ৳৯০০'",
